<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into SignPath: project > Artifact configurations > custom XML.
     The release workflow uploads squad.exe as a GitHub artifact, which GitHub zips. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="squad.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
